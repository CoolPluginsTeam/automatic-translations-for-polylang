        <key name="*">
          <key name="*">
            <key name="cells">
              <key name="*">
                <key name="content"/>
              </key>
            </key>
          </key>
        </key>
      </key>
      <key name="head">
        <key name="*">
          <key name="cells">
            <key name="*">
              <key name="content"/>
            </key>
          </key>
        </key>
      </key>
      <key name="foot">
        <key name="*">
          <key name="cells">
            <key name="*">
              <key name="content"/>
            </key>
          </key>
        </key>
      </key>
      <xpath>//th</xpath>
      <xpath>//td</xpath>
