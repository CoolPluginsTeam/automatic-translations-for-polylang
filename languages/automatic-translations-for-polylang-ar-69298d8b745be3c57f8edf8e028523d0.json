["\u062f\u0642\u0629 \u0623\u0641\u0636\u0644"],"Improved context-aware translations.":["\u062a\u0631\u062c\u0645\u0627\u062a \u0645\u062d\u0633\u0651\u0646\u0629 \u062a\u0631\u0627\u0639\u064a \u0627\u0644\u0633\u064a\u0627\u0642."],"Save Time & Effort":["\u0648\u0641\u0651\u0631 \u0627\u0644\u0648\u0642\u062a \u0648\u0627\u0644\u062c\u0647\u062f"],"No need to translate them one by one.":["\u0644\u0627 \u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u062a\u0631\u062c\u0645\u062a\u0647\u0627 \u0648\u0627\u062d\u062f\u0629 \u062a\u0644\u0648 \u0627\u0644\u0623\u062e\u0631\u0649."],"More Editor Support":["\u062f\u0639\u0645 \u0623\u0648\u0633\u0639 \u0644\u0644\u0645\u062d\u0631\u0631\u0627\u062a"],"Translate content built without blocks, including the classic editor and page builders.":["\u062a\u0631\u062c\u0645 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u064f\u0646\u0634\u0623 \u062f\u0648\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0643\u062a\u0644\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0645\u062d\u0631\u0631 \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a \u0648\u0645\u0646\u0634\u0626\u0648 \u0627\u0644\u0635\u0641\u062d\u0627\u062a."],"No need to translate manually again.":["\u0644\u0627 \u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u064a\u062f\u0648\u064a\u064b\u0627."],"Unlock Re-Translation with AutoPoly Pro":["\u0627\u0643\u062a\u0634\u0641 \u0645\u064a\u0632\u0629 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u0645\u0639 AutoPoly Pro"],"Upgrade to Pro to re-translate existing content with AI.":["\u0642\u0645 \u0628\u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0625\u0644\u0649 Pro \u0644\u0625\u0639\u0627\u062f\u0629 \u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062d\u0627\u0644\u064a \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a."],"Already translated this content?":["\u0647\u0644 \u062a\u0631\u062c\u0645\u062a \u0647\u0630\u0627 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0642\u0628\u0644\u061f"],"AutoPoly Pro lets you translate it again with AI whenever your original content changes.":["\u064a\u062a\u064a\u062d \u0644\u0643 AutoPoly Pro \u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u062c\u062f\u062f\u064b\u0627 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0643\u0644\u0645\u0627 \u062a\u063a\u064a\u0651\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0623\u0635\u0644\u064a."],"Re-translate Existing Content":["\u0625\u0639\u0627\u062f\u0629 \u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062d\u0627\u0644\u064a"],"Translate previously translated pages again with AI.":["\u0623\u0639\u062f \u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u062a\u0631\u062c\u0645\u0629 \u0633\u0627\u0628\u0642\u064b\u0627 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a."],"Re-translate in One Click":["\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629"],"Start AI re-translation quickly without recreating translations manually.":["\u0627\u0628\u062f\u0623 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0628\u0633\u0631\u0639\u0629 \u062f\u0648\u0646 \u0627\u0644\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062a\u0631\u062c\u0645\u0627\u062a \u064a\u062f